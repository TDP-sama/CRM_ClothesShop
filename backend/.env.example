# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit real credentials.

# Required: PostgreSQL JDBC URL including credentials.
DATABASE_URL=jdbc:postgresql://<host>/<db>?user=<user>&password=<password>&sslmode=require

# Accounts with these emails become administrators (comma-separated).
ADMIN_EMAILS=admin@example.com

# Optional, with `docker compose up -d` running:
# Keep login sessions in Redis instead of memory.
#spring.profiles.active=redis
# Send order emails to Mailpit (inbox at http://localhost:8025).
#spring.mail.host=localhost
#spring.mail.port=1025
